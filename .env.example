# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/studio_guardian
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/studio_guardian

# Server
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Google Cloud & Gemini
GOOGLE_CLOUD_PROJECT=studio-guardian-demo
GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Grafana MCP Integration
GRAFANA_URL=http://localhost:3000
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_example_token_123
GRAFANA_MCP_SERVER_URL=http://localhost:8001
USE_MOCK_GRAFANA_MCP=false

# Media Simulator & Policy
MAX_REMEDIATION_RETRIES=2
AUTO_EXECUTE_MAX_BLAST_RADIUS_PCT=25.0
AUTO_EXECUTE_MIN_CONFIDENCE=0.85
VIDEO_PROXY_URL=http://localhost:8000/api/v1/simulator/route
